{
  "name": "next-unlock",
  "version": "2.5.3",
  "description": "Next Unlock - Smart Achievement Tracker & Recommendation Engine for Steam Deck",
  "author": "Vladas Maier",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i ./src/index.css -o ./src/generated.css",
    "build": "tailwindcss -i ./src/index.css -o ./src/generated.css && tsc --noEmit && rollup -c",
    "test": "tailwindcss -i ./src/index.css -o ./src/generated.css && vitest run",
    "test:python": "uv run pytest",
    "smoke": "node scripts/smoke_test_bundle.mjs",
    "verify": "just verify",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.35",
    "rollup": "^4.63.2",
    "rollup-plugin-external-globals": "^0.13.0",
    "rollup-plugin-import-css": "^4.2.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^5.1.6",
    "vitest": "^1.6.1"
  }
}
